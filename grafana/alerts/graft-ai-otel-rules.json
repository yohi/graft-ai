[
  {
    "uid": "graft-otel-backend-export-exhausted",
    "title": "OtelBackendExportExhausted",
    "ruleGroup": "graft-ai-otel",
    "folderUID": "general",
    "orgId": 1,
    "condition": "B",
    "noDataState": "OK",
    "execErrState": "Error",
    "for": "5m",
    "annotations": {
      "summary": "An OTel backend has exhausted its export retries"
    },
    "labels": {
      "service": "graft-ai-otel",
      "severity": "critical"
    },
    "data": [
      {
        "refId": "A",
        "queryType": "",
        "relativeTimeRange": {"from": 600, "to": 0},
        "datasourceUid": "otel-prometheus",
        "model": {
          "expr": "sum by (backend) (increase(otel_backend_export_exhausted_total[5m]))",
          "hide": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "A"
        }
      },
      {
        "refId": "B",
        "queryType": "",
        "relativeTimeRange": {"from": 0, "to": 0},
        "datasourceUid": "-100",
        "model": {
          "conditions": [{
            "evaluator": {"params": [1], "type": "gte"},
            "operator": {"type": "and"},
            "query": {"params": ["A"]},
            "reducer": {"params": [], "type": "last"},
            "type": "query"
          }],
          "datasource": {"type": "__expr__", "uid": "-100"},
          "hide": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "refId": "B",
          "type": "classic_conditions"
        }
      }
    ]
  },
