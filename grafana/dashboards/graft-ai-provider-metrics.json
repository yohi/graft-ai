{
  "dashboard": {
    "id": null,
    "uid": "graft-ai-provider-metrics",
    "title": "graft-ai — AI Provider Usage & Rate Limits",
    "description": "Unified dashboard for OpenAI API, Codex, Ollama Cloud, and OpenCode Go usage, costs, and rate limit resets via graft-ai",
    "tags": [
      "graft-ai",
      "openai",
      "codex",
      "ollama-cloud",
      "opencodego",
      "prometheus"
    ],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 3,
    "refresh": "1m",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ]
    },
    "templating": {
      "list": []
    },
    "panels": [
      {
        "id": 100,
        "type": "row",
        "title": "OpenAI API (Platform & Costs)",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 1
        },
        "collapsed": false,
        "panels": []
      },
      {
        "id": 1,
        "type": "stat",
        "title": "OpenAI Today Cost",
        "gridPos": {
          "x": 0,
          "y": 1,
          "w": 6,
          "h": 4
        },
        "datasource": {
          "type": "prometheus",
          "uid": "grafanacloud-prom"
        },
        "options": {
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ]
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "area"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 5
                },
                {
                  "color": "red",
                  "value": 20
                }
              ]
            },
            "unit": "currencyUSD"
          }
        },
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "grafanacloud-prom"
            },
            "expr": "sum(openai_api_cost_usd)",
            "legendFormat": "Total Cost",
            "refId": "A",
            "instant": true
          }
        ]
      },
      {
        "id": 2,
        "type": "stat",
        "title": "OpenAI Requests (24h)",
        "gridPos": {
          "x": 6,
