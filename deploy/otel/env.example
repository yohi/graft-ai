OTEL_INGEST_TOKEN_FILE=./secrets/otel_ingest_token
OTEL_RATE_LIMIT_HMAC_KEY_FILE=./secrets/otel_hmac_key
OTEL_TRUSTED_PROXY_CIDRS=172.30.0.10/32
OTEL_SAMPLING_RATE=1
OTEL_TUNNEL_TOKEN_FILE=./secrets/cloudflared_token
# Required with the Grafana Cloud Compose override. Compose checks only that
# this value is non-empty. Alloy enables Cloud Loki payload logs only for a
# positive whole-number d, h, m, or s duration no greater than 14 days.
# Confirm the effective Grafana Cloud Logs retention before setting this value.
# OTEL_GRAFANA_CLOUD_LOGS_RETENTION=14d
# Cloud mode only: pass these values through the Compose override. Keep the
# Authorization values in a local untracked env file or secret manager.
# OTEL_TEMPO_URL=https://<region>.grafana.net/otlp/v1/traces
# OTEL_TEMPO_AUTHORIZATION=Basic <base64(instance_id:access_policy_token)>
# OTEL_LOKI_URL=https://<region>.grafana.net/loki/api/v1/push
# OTEL_LOKI_AUTHORIZATION=Basic <base64( Logs user ID:access_policy_token )>
# OTEL_PROMETHEUS_URL=https://<region>.grafana.net/otlp/v1/metrics
# OTEL_PROMETHEUS_AUTHORIZATION=Basic <base64(Prometheus user ID:access_policy_token)>
